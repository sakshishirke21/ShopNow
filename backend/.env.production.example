# Copy this file to `.env` ON THE LIVE SERVER (not on your laptop).
# Replace every <angle-bracket> placeholder with your real production value.

NODE_ENV=production
PORT=5000

# Use a real MongoDB Atlas (or other externally-reachable MongoDB) connection string.
# Do NOT use mongodb://127.0.0.1:27017/... in production - that only works on your own machine.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<your-cluster>.mongodb.net/shopnow?retryWrites=true&w=majority

# Generate your own on the server - never reuse the same secret across environments
# or commit real values to git. Run this on the server and paste the output in:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<paste-a-freshly-generated-64-char-random-secret>
COOKIE_SECRET=<paste-a-different-freshly-generated-64-char-random-secret>
JWT_EXPIRES_IN=30d

# Your real public domain (must match exactly, including https:// and no trailing slash).
CLIENT_ORIGIN=https://your-domain.com
PUBLIC_URL=https://your-domain.com

UPLOAD_MAX_MB=10

# Real SMTP credentials so order/contact emails actually send.

# Swap these for your LIVE Razorpay keys before accepting real payments.
# (Keys starting with rzp_test_ only work in Razorpay's test mode - real customers can't pay with them.)

# Not used by the current codebase (no Stripe/PayPal routes exist yet) - safe to leave blank or delete.
# If you add Stripe/PayPal checkout later, put real live keys here, never in any frontend file.
