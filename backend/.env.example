NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/shopnow?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-64-character-random-secret
JWT_EXPIRES_IN=30d
COOKIE_SECRET=replace-with-another-random-secret
CLIENT_ORIGIN=http://localhost:5000
PUBLIC_URL=https://shopnow.example.com
UPLOAD_MAX_MB=10

# Put payment/shipping provider credentials in Admin > Settings, not this file.
