{
  "installCommand": "npm install --prefix backend",
  "functions": {
    "api/index.js": {
      "includeFiles": "backend/uploads/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/",
      "destination": "/frontend/user.html"
    }
  ]
}